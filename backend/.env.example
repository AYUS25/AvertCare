# AvertCare Backend — Runtime Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   cp backend/.env.example backend/.env
#   Fill in the values marked <YOUR_VALUE_HERE>
#   NEVER commit .env to git — it is in .gitignore
# ──────────────────────────────────────────────────────────────────────────────

APP_NAME=AvertCare API
APP_VERSION=0.1.0
DEBUG=false

# ── Internal Service URLs ──────────────────────────────────────────────────────
# When running via Docker Compose, these are overridden to Docker service names.
# For local (non-Docker) development, keep these as localhost.
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# ── Firebase Auth ──────────────────────────────────────────────────────────────
# Get this from: Firebase Console → Project Settings → General → Project ID
# If left blank, the auth middleware runs in DEV BYPASS mode (no JWT required).
# MUST be set in production / staging environments.
FIREBASE_PROJECT_ID=avertcare

# ── Gemini API ────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.8-flash

# ── ML Model Path ─────────────────────────────────────────────────────────────
# Path inside the container. Mapped via Docker volume mount in docker-compose.yml
MODEL_PATH=/app/models

# ── Feature Flags ─────────────────────────────────────────────────────────────
# LIVE_RAG_ENABLED: Set to true AFTER seeding Qdrant (scripts/seed_rag_engine.py)
LIVE_RAG_ENABLED=true
# LIVE_LLM_ENABLED: Set to true AFTER setting a valid GEMINI_API_KEY above
LIVE_LLM_ENABLED=false
