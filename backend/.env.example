# AvertCare Backend Environment Variables
# Copy to .env and fill in real values — NEVER commit .env to git

APP_NAME=AvertCare API
APP_VERSION=0.1.0
DEBUG=false

QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# Firebase Admin SDK (set in production via CI/CD secrets)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ML model mount path (maps to Docker volume)
MODEL_PATH=/app/models
