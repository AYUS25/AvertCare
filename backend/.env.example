# AvertCare Backend Environment Variables
# Copy to .env and fill real values — NEVER commit .env to git

APP_NAME=AvertCare API
APP_VERSION=0.1.0
DEBUG=false

QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# ── Firebase Auth (set once you create the project in Firebase Console) ──
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Gemini API ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ── Feature Flags ───────────────────────────────────────────────────────
# Set to true AFTER running: python scripts/seed_rag_engine.py
LIVE_RAG_ENABLED=false
# Set to true AFTER setting GEMINI_API_KEY above
LIVE_LLM_ENABLED=false

# ── ML model mount path (maps to Docker volume) ─────────────────────────
MODEL_PATH=/app/models
