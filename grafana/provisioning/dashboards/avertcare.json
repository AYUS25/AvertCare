{
  "__inputs": [{ "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }],
  "title": "AvertCare MLOps",
  "uid": "avertcare-mlops",
  "schemaVersion": 38,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Request Throughput (RPS)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [{ "expr": "sum(rate(fastapi_requests_total[1m]))", "legendFormat": "RPS" }],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 50, "color": "yellow" }, { "value": 100, "color": "red" }] } } }
    },
    {
      "id": 2, "type": "gauge", "title": "P95 Inference Latency (ms)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(fastapi_requests_duration_seconds_bucket[1m])) by (le)) * 1000", "legendFormat": "P95 ms" }],
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "max": 500, "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 150, "color": "yellow" }, { "value": 300, "color": "red" }] } } }
    },
    {
      "id": 3, "type": "gauge", "title": "P99 Inference Latency (ms)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(fastapi_requests_duration_seconds_bucket[1m])) by (le)) * 1000", "legendFormat": "P99 ms" }],
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "max": 1000, "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 300, "color": "yellow" }, { "value": 600, "color": "red" }] } } }
    },
    {
      "id": 4, "type": "stat", "title": "HTTP Error Rate (4xx/5xx)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [{ "expr": "sum(rate(fastapi_requests_total{status=~'4..|5..'}[1m]))", "legendFormat": "Errors/s" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "red" }] } } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Inference Latency Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(fastapi_requests_duration_seconds_bucket[1m])) by (le)) * 1000", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(fastapi_requests_duration_seconds_bucket[1m])) by (le)) * 1000", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(fastapi_requests_duration_seconds_bucket[1m])) by (le)) * 1000", "legendFormat": "P99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Request Volume (2xx vs 4xx/5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [
        { "expr": "sum(rate(fastapi_requests_total{status=~'2..'}[1m]))", "legendFormat": "2xx Success" },
        { "expr": "sum(rate(fastapi_requests_total{status=~'4..|5..'}[1m]))", "legendFormat": "4xx/5xx Errors" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } } }
    }
  ]
}
